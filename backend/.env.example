# ==============================================================================
# EduBridge AI Backend Environment Configuration (.env)
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
PROJECT_NAME="EduBridge AI Backend"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security & Authentication (Generate secure keys with `openssl rand -hex 32`)
SECRET_KEY=dev_secret_key_change_in_production_min32chars_edubridge
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_min32chars_edubridge
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL Async connection string)
# For local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/edubridge_ai
# For local SQLite development/testing fallback: sqlite+aiosqlite:///./edubridge_ai.db
DATABASE_URL=sqlite+aiosqlite:///./edubridge_ai.db

# Synchronous Database URL for Alembic Migrations
# For local PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/edubridge_ai
# For SQLite: sqlite:///./edubridge_ai.db
DATABASE_URL_SYNC=sqlite:///./edubridge_ai.db

# Gemma 4 Cloud AI Tutor Integration
GEMMA_PROVIDER=google_ai_studio
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT=30
GEMMA_MAX_OUTPUT_TOKENS=2048
GEMMA_TEMPERATURE=0.3

# Sign Language Recognition & Confidence Settings
SIGN_CONFIDENCE_THRESHOLD=0.70
SIGN_LANGUAGE_DEFAULT=ISL
MAX_TEMPORAL_BUFFER_FRAMES=30

# CORS Allowed Origins (Comma-separated for frontend integrations, Stitch, AI Studio)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Asset & Model Paths
MODELS_DIR=./ml/model_registry
SIGML_DIR=./ml/assets/sigml

